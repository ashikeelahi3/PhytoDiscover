# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# Password for the existing phytochem_db source database (used only by the migration script)
PHYTOCHEM_DB_PASSWORD=changeme

# Full DSN used by SQLAlchemy / Alembic
DATABASE_URL=postgresql://phyto:changeme@localhost:5432/phytodiscover

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used as Celery broker, result backend, and pub/sub channel for job status
REDIS_URL=redis://localhost:6379/0

# ── Workspaces ────────────────────────────────────────────────────────────────
# Absolute path where per-job directories are created by directory_creation()
WORKSPACE_BASE_PATH=/workspaces/phytodiscover

# ── AutoDock Vina ─────────────────────────────────────────────────────────────
# Absolute path to the vina executable (or directory containing it).
# Mac Homebrew default: /usr/local/bin/vina
# Linux typical:        /usr/bin/vina
VINA_PATH=/usr/local/bin/vina

# ── Application ───────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false
