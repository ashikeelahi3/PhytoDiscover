# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme

# Password for the existing phytochem_db source database (used only by the migration script)
PHYTOCHEM_DB_PASSWORD=changeme

# Full DSN used by SQLAlchemy / Alembic
DATABASE_URL=postgresql://phyto:changeme@localhost:5432/phytodiscover

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used as Celery broker, result backend, and pub/sub channel for job status
REDIS_URL=redis://localhost:6379/0

# ── Workspaces ────────────────────────────────────────────────────────────────
# Directory where docking job files are stored.
# Change this to an absolute path on your server.
# The directory will be created automatically if it does not exist.
# Mac local:     WORKSPACE_BASE_PATH=/Users/yourname/Desktop/PhytoDiscover/workspaces
# Ubuntu server: WORKSPACE_BASE_PATH=/home/phytodiscover/workspaces
WORKSPACE_BASE_PATH=/tmp/phytodiscover_workspaces

# ── AutoDock Vina ─────────────────────────────────────────────────────────────
# Absolute path to the vina executable (or directory containing it).
# Mac Homebrew default: /usr/local/bin/vina
# Linux typical:        /usr/bin/vina
VINA_PATH=/usr/local/bin/vina

# ── Application ───────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false
